{
  "name": "derpibooru-mirror-engine",
  "version": "0.1.0",
  "private": false,
  "description": "Fixed-origin reverse proxy for Derpibooru with Anubis compatibility",
  "license": "MIT",
  "bin": { "derpibooru-mirror": "src/server.mjs" },
  "files": ["src/**/*.mjs", "config/config.example.json", "README.md", "CHANGELOG.md", "LICENSE"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter spec \"test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "http-proxy": "1.18.1",
    "parse5": "7.3.0",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "tough-cookie": "6.0.0"
  },
  "devDependencies": {
    "ws": "8.22.1"
  }
}
